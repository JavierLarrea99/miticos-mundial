<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/negro">

    <Button
        android:id="@+id/botonVolver"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:textColor="@color/oro" android:textAllCaps="false" android:text="⬅ Volver" />

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Meter resultados" android:textColor="@color/blanco"
        android:textSize="24sp" android:textStyle="bold" android:padding="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAdmin"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="6dp" />
</LinearLayout>